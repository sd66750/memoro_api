# ============================================================
# Memoro API — variables d'environnement (modèle)
# Copier en .env.local et renseigner. NE JAMAIS commiter .env.local.
# ============================================================

# Serveur
PORT=8090

# Base MySQL (même instance que HomeFlow ; base dédiée `memoro`)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=memoro
DB_PASSWORD=__A_RENSEIGNER__
DB_NAME=memoro

# JWT
SECRET_KEY=__A_RENSEIGNER__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Anthropic (génération fiche / cartes / QCM)
ANTHROPIC_API_KEY=__A_RENSEIGNER__

# Stockage des PDF (répertoire disque hors web-root)
STORAGE_DIR=./storage

# CORS : origines autorisées du front (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,https://memoro.fr,https://app.memoro.fr
